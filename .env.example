SPOTIFY_CLIENT_ID=your_spotify_client_id

# Visitor access (specs/011-viewer-access). Names only: fill these from `tofu output -raw`, never paste them anywhere.
# Used by the `viewer` commands on your Mac, one pair per Neon branch.
VIEWERS_OWNER_URL_DEV=
VIEWERS_APP_URL_DEV=
VIEWERS_OWNER_URL_PROD=
VIEWERS_APP_URL_PROD=
# Signs the login cookie. Vercel sets both of these on the hosted site; set them yourself only to run the
# site in hosted mode on your Mac against the dev branch (DATABASE_URL = the VIEWERS_APP_URL_DEV value).
SESSION_SECRET=
DATABASE_URL=
